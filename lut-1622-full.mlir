    %c128 = arith.constant 128 : index
    %37 = arith.muli %21, %c128 : index
    %reinterpret_cast_15 = memref.reinterpret_cast %base_buffer_11 to offset: [%37], sizes: [128], strides: [1] : memref<f32, #hivm.address_space<gm>> to memref<128xf32, strided<[1], offset: ?>, #hivm.address_space<gm>>
    hivm.hir.wait_flag[<PIPE_V>, <PIPE_MTE3>, <EVENT_ID0>]
    hivm.hir.pipe_barrier[<PIPE_MTE3>]
    %cast_16 = memref.cast %reinterpret_cast_10 : memref<128xf32, strided<[1]>, #hivm.address_space<ub>> to memref<?xf32, strided<[?], offset: ?>, #hivm.address_space<ub>>
    %cast_17 = memref.cast %reinterpret_cast_15 : memref<128xf32, strided<[1], offset: ?>, #hivm.address_space<gm>> to memref<?xf32, strided<[?], offset: ?>, #hivm.address_space<gm>>
    call @store_ubuf_to_gm_1d_float(%cast_16, %cast_17, %9) : (memref<?xf32, strided<[?], offset: ?>, #hivm.address_space<ub>>, memref<?xf32, strided<[?], offset: ?>, #hivm.address_space<gm>>, i32) -> ()
    hivm.hir.set_flag[<PIPE_MTE3>, <PIPE_V>, %30]
    %38 = arith.addi %18, %7 overflow<nsw> : i32
    cf.br ^bb1(%38 : i32)
  ^bb3:  // pred: ^bb1
    hivm.hir.pipe_barrier[<PIPE_ALL>]
    hivm.hir.wait_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID0>]
    hivm.hir.wait_flag[<PIPE_MTE3>, <PIPE_V>, <EVENT_ID1>]
    return
  }
}

